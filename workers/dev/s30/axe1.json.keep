[{"name": "start", "js": "const a=__bw.econ.st.army; a.army={spear:8,sword:6,archer:8,cavalry:5,axerider:5,lord:1,pegasus:2}; a.forge=14; a.lv={}; const T={levels:{keep:14,wall:14,towers:14},seed:11,ratio:1.0,power:3000,loot:{turq:60,emerald:60,ruby:60},tesla:0,emblem:'swords',name:'Navid'}; __bw.battle.start(T,null,null); for(let i=0;i<1200;i++){ await new Promise(r=>setTimeout(r,500)); if(__bw.battle.session && !__bw.battle.loading) break; } const S=__bw.battle.session; S.cam.intro=0; return {ok:!!S, n:S.sim.units.length};", "frames": 10, "wait": 3, "shot": true}, {"name": "send", "js": "const S=__bw.battle.session, sim=S.sim; S.sel=null; S.started=true; S.hud.el.style.display='none'; const g=sim.base.deploy; const tx=-g.nz, tz=g.nx; for(let i=0;i<3;i++){ const gx=g.x-g.nx*62+tx*(i-1)*7, gz=g.z-g.nz*62+tz*(i-1)*7; sim.send('axerider',gx,gz); sim.send('cavalry',gx+tx*24,gz+tz*24); } sim.send('lord', g.x-g.nx*62+tx*-26, g.z-g.nz*62+tz*-26); const us=sim.units.filter(u=>u.type==='axerider'); const u=us[1]; S.cam.tx=u.x+tx*12; S.cam.tz=u.z+tz*12; S.cam.dist=34; S.cam.pitch=0.25; S.confirming=true; return {n:us.length, u:[u.x|0,u.z|0], types:Object.fromEntries(['axerider','cavalry','lord'].map(t=>[t,sim.units.filter(x=>x.type===t).length]))};", "frames": 12, "wait": 2, "shot": true}, {"name": "run", "js": "const S=__bw.battle.session, sim=S.sim; S.confirming=false; for(let k=0;k<12;k++) sim.step(0.1); const us=sim.units.filter(u=>u.type==='axerider'); const u=us[1]; const g=sim.base.deploy; S.cam.tx=u.x+(-g.nz)*12; S.cam.tz=u.z+g.nx*12; S.cam.dist=30; S.cam.pitch=0.2; S.confirming=true; return {u:[u.x|0,u.z|0], t:+sim.time.toFixed(1)};", "frames": 8, "wait": 1, "shot": true}, {"name": "close", "js": "const S=__bw.battle.session, sim=S.sim; const us=sim.units.filter(u=>u.type==='axerider'); const u=us[1]; S.cam.tx=u.x; S.cam.tz=u.z; S.cam.dist=13; S.cam.pitch=0.14; S.cam.az=S.cam.az0+1.2; return {u:[u.x|0,u.z|0]};", "frames": 6, "wait": 1, "shot": true}, {"name": "close2", "js": "const S=__bw.battle.session, sim=S.sim; const us=sim.units.filter(u=>u.type==='cavalry'); const u=us[1]; S.cam.tx=u.x; S.cam.tz=u.z; S.cam.dist=13; S.cam.pitch=0.14; S.cam.az=S.cam.az0+1.2; return {u:[u.x|0,u.z|0]};", "frames": 6, "wait": 1, "shot": true}]