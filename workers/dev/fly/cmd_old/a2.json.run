[{"name": "hud", "js": "const h=document.querySelector('.bwb'); if(h) h.style.display='none'; return !!h;\n", "frames": 1, "shot": false}, {"name": "r", "js": "window.__R={order:['darkrider','gryphonknight','gryphon','dragon3','dragon','baby3','baby'],gap:44,dist:250,ty:13,el:0.10,fov:34}; return 1", "frames": 1, "shot": false}, {"name": "row", "js": "// arrange: one unit of each wanted type in a row, active (flying), facing the camera at an angle; camera free\nconst S=__bw.battle.session, dp=S.sim.deploy, R=window.__R||{};\nconst order=R.order||['baby','baby3','dragon','dragon3','pegasus','spear'], gap=R.gap||40, face=R.face??(Math.PI+0.55);\nconst cx=dp.x, cz=dp.z, used=new Set(); let i=0;\nfor(const ty of order){ const u=S.sim.units.find(q=>q.type===ty && !used.has(q.id)); if(!u) continue; used.add(u.id); u.x=cx+(i-(order.length-1)/2)*gap; u.z=cz; u.face=face; u.active=true; i++; }\nfor(const u of S.sim.units){ if(!used.has(u.id)){ u.x=cx+500; u.z=cz+500; } }       // park the others away\nS.cam.free=true;\nconst c=__bw.camera, H=S.H;\nconst ty=R.ty??12, d=R.dist??150, el=R.el??0.18, az=R.az??0;\nc.position.set(cx+Math.sin(az)*d, H(cx,cz)+ty+d*el, cz-Math.cos(az)*d);\nc.fov=R.fov||35; c.updateProjectionMatrix(); c.lookAt(cx, H(cx,cz)+ty, cz); c.updateMatrixWorld(true);\nfor(const u of S.sim.units){ const v=S.views.views.get(u.id); if(v) v.yaw=u.face; }\nreturn {placed:[...used].length, cam:[c.position.x,c.position.y,c.position.z]};\n", "frames": 24}]