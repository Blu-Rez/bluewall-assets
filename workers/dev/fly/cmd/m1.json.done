[{"name": "meas", "js": "const S=__bw.battle.session, K=S.views.kinds, out={}, R=__bw.renderer;\nconst info=(root)=>{ const a=[]; root.traverse(o=>{ if(!o.isMesh) return; const g=o.geometry; a.push({n:(o.name||o.type).slice(0,14), sk:!!o.isSkinnedMesh, inst:o.isInstancedMesh?o.count:0, tris:Math.round((g.index?g.index.count:g.attributes.position.count)/3), verts:g.attributes.position.count, bones:o.skeleton?o.skeleton.bones.length:0, sh:!!o.castShadow}); }); return a; };\nfor(const k of ['pegasus','dragon','baby','dragon3','baby3','gryphon','gryphonknight','darkrider']){\n  const kk=K[k]; if(!kk){ out[k]='nokind'; continue; }\n  let root=kk.group; const i0=kk.instances&&kk.instances[0]; if(i0&&i0.c&&i0.c.root) root=i0.c.root;\n  const m=info(root);\n  out[k]={meshes:m.length, tris:m.reduce((s,x)=>s+x.tris,0), skinned:m.filter(x=>x.sk).length, instanced:m.filter(x=>x.inst>=0&&x.n!=='Object3D').length, bones:Math.max(0,...m.map(x=>x.bones)), shadow:m.filter(x=>x.sh).length, detail:m.slice(0,14).map(x=>x.n+':'+x.tris+(x.inst?'x'+x.inst:'')).join(' ')};\n}\nreturn out;\n", "frames": 1, "shot": false}, {"name": "x", "js": "window.__R={order:[\"dragon3\",\"dragon3\",\"baby3\",\"baby3\",\"gryphon\",\"gryphon\",\"gryphon\",\"gryphonknight\",\"gryphonknight\",\"darkrider\",\"darkrider\",\"dragon\",\"dragon\",\"baby\",\"baby\",\"pegasus\",\"pegasus\"],gap:7,face:0,az:0.6,el:0.8,d:150,lift:true};return 1;", "shot": false}, {"name": "cluster", "js": "// row.js: window.__R = { order:[types], gap, face (rad), az (camera azimuth rel. to the unit heading, 0 = in front), el (rad), d (m), ty (look height above the unit's flight height), fwd, lift:true }\nconst S=__bw.battle.session, dp=S.sim.deploy, R=window.__R||{}, H=S.H, c=__bw.camera;\nconst order=R.order||['dragon3'], gap=R.gap||40, face=R.face??0;\nconst cx=R.cx??dp.x, cz=R.cz??dp.z, used=new Set(); let i=0; const picked=[];\nfor(const ty of order){ const u=S.sim.units.find(q=>q.type===ty && !used.has(q.id)); if(!u) continue; used.add(u.id); picked.push(u); u.x=cx+(i-(order.length-1)/2)*gap*Math.cos(R.rowAng||0); u.z=cz+(i-(order.length-1)/2)*gap*Math.sin(R.rowAng||0); u.face=face; u.active=true; i++; }\nfor(const u of S.sim.units){ if(!used.has(u.id)){ u.x=cx+700+u.id; u.z=cz+700; } }\nS.cam.free=true;\nlet ly=0; for(const u of picked){ const v=S.views.views.get(u.id); if(v){ v.yaw=face; v.lx=u.x; v.lz=u.z; if(R.lift!==false) v.ly=v.T.lift; ly=Math.max(ly,v.T.lift); } }\nconst g0=H(cx,cz), ty=g0+(R.ty??ly*0.8), d=R.d??150, el=R.el??0.2, a=face+(R.az??0.6);\nc.position.set(cx+Math.sin(a)*d*Math.cos(el), ty+Math.sin(el)*d, cz+Math.cos(a)*d*Math.cos(el)); c.lookAt(cx,ty,cz); c.updateMatrixWorld(true);\nreturn {n:picked.length, cam:c.position.toArray().map(x=>+x.toFixed(1)), target:[cx,ty,cz], g0};\n", "frames": 3, "shot": false}, {"name": "upd", "js": "const S=__bw.battle.session, cam=__bw.camera; const n=30; for(let i=0;i<5;i++) S.views.update(S.t+0.033*(i+1),0.033,cam);\nconst t0=performance.now(); for(let i=0;i<n;i++){ S.views.update(S.t+0.2+0.033*(i+1),0.033,cam); } const ms=(performance.now()-t0)/n;\nconst vis={}; for(const [k,kk] of Object.entries(S.views.kinds)){ if(kk.drawn) vis[k]=kk.drawn[0]; }\nreturn {msPerUpdate:+ms.toFixed(2), units:S.sim.units.length, vis};\n", "frames": 1, "shot": false}, {"name": "i0", "js": "const R=__bw.renderer; R.info.autoReset=false; R.info.reset(); window.__f0=__bw.frames; return 1;\n", "frames": 3, "shot": false}, {"name": "i1", "js": "const R=__bw.renderer, S=__bw.battle.session, K=S.views.kinds, i=R.info.render, nf=__bw.frames-window.__f0, r1={nf,calls:i.calls,tris:i.triangles};\nwindow.__r1=r1; window.__hid=['pegasus','dragon','baby','dragon3','baby3','gryphon','gryphonknight','darkrider'].filter(k=>K[k]); for(const k of window.__hid) K[k].group.visible=false;\nR.info.reset(); window.__f0=__bw.frames; return r1;\n", "frames": 3, "shot": false}, {"name": "i2", "js": "const R=__bw.renderer, S=__bw.battle.session, K=S.views.kinds, i=R.info.render, nf